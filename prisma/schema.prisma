datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String?   // optional banaya
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  price       Float
  image       String
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            Int      @id @default(autoincrement())
  name          String
  address       String
  phone         String
  productId     String   // <-- yahan String rakho
  quantity      Int
  paymentMethod String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}